# UjjwalRouter Configuration
# ==========================
# SECURITY & POLICY
# Strict free-only mode is mandatory by default and cannot be disabled from the web dashboard.
STRICT_FREE_ONLY=true

# Server networking (localhost-first)
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
NODE_ENV=development

# Local API authentication (generate with: openssl rand -hex 32)
# Multiple comma-separated client API keys are supported for local services/agents
ROUTER_API_KEYS=
# Dashboard admin password/token (generate with: openssl rand -hex 32)
DASHBOARD_ADMIN_TOKEN=
# Optional secret encryption key for local encrypted secret store (32-byte hex)
SECRET_ENCRYPTION_KEY=

# Database & retention
DATABASE_PATH=./data/ujjwalrouter.db
LOG_RETENTION_DAYS=30
DISCOVERY_REFRESH_INTERVAL_MS=900000
HEALTH_CHECK_INTERVAL_MS=300000

# Routing & context safety
DEFAULT_ROUTING_PROFILE=auto
CONTEXT_SAFETY_MARGIN_PCT=0.05
CONTEXT_SAFETY_MARGIN_TOKENS=1024
DEFAULT_RESERVED_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_MS=120000
FIRST_BYTE_TIMEOUT_MS=25000
MAX_REQUEST_BODY_BYTES=10485760

# Upstream Provider Credentials & Entitlement Verification
# --------------------------------------------------------
# 1. Google Gemini API (Google AI Studio Free Tier)
# Only set GOOGLE_PROJECT_NO_BILLING=true if your Google AI Studio project has NO billing linked.
GOOGLE_API_KEY=
GOOGLE_PROJECT_NO_BILLING=false

# 2. Groq API (Permanent Free Plan - NO credit card required)
# Set GROQ_FREE_PLAN_CONFIRMED=true once verified your Groq org is on the Free Plan with no billing.
GROQ_API_KEY=
GROQ_FREE_PLAN_CONFIRMED=false

# 3. SambaNova Cloud (Permanent Free Tier - NO credit card linked)
# Set SAMBANOVA_FREE_TIER_CONFIRMED=true if no card / Developer trial credits are linked.
SAMBANOVA_API_KEY=
SAMBANOVA_FREE_TIER_CONFIRMED=false

# 4. Mistral AI La Plateforme (Experiment/Free Plan - NO credit card required)
MISTRAL_API_KEY=
MISTRAL_FREE_PLAN_CONFIRMED=false

# 5. Cloudflare Workers AI (Workers Free Plan: 10,000 Neurons/day, hard capped)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# 6. Cohere Compatibility API (Non-expiring Trial key: 20 RPM, 1,000 calls/mo, no card)
COHERE_API_KEY=
COHERE_FREE_PLAN_CONFIRMED=false

# 7. Local Ollama (Zero-cost local hardware inference; excludes :cloud paid relays)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 8. OpenRouter API (only :free zero-priced models are ever allowed)
OPENROUTER_API_KEY=

# 9. NVIDIA NIM Hosted API (integrate.api.nvidia.com)
# Note: Free NVIDIA developer accounts use finite prototyping credits (TRIAL_ONLY).
# Only set NVIDIA_HOSTED_FREE_NO_CREDITS_CONFIRMED=true if your account has verified non-credit free inference.
NVIDIA_API_KEY=
NVIDIA_HOSTED_FREE_NO_CREDITS_CONFIRMED=false

# 10. Hugging Face Inference Providers (disabled by default; free tier uses $0.10/mo promotional credits)
HUGGINGFACE_ENABLED=false
HF_TOKEN=
