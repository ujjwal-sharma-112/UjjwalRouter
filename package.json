{
  "name": "ujjwalrouter",
  "version": "0.1.0",
  "description": "Production-grade free-only multi-provider LLM router for Hermes Agent and OpenAI-compatible clients",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs => fs.cpSync('src/database/migrations', 'dist/database/migrations', { recursive: true }))\"",
    "build:dashboard": "npm --workspace=apps/dashboard run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:providers": "vitest run tests/providers",
    "test:hermes": "vitest run tests/hermes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.2",
    "openai": "^4.91.1",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
